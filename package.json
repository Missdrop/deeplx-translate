{
  "name": "deeplx-translate",
  "displayName": "DeeplX Translation Source",
  "description": "Connects Comment Translate to a DeeplX server.",
  "version": "0.1.0",
  "publisher": "Missdrop",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "icon": "images/icon.png",
  "extensionDependencies": [
    "intellsmi.comment-translate"
  ],
  "activationEvents": [
    "onCommand:deeplxSource.setToken",
    "onCommand:deeplxSource.clearToken"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "contributes": {
    "translates": [
      {
        "translate": "dlx",
        "title": "DeeplX"
      }
    ],
    "commands": [
      {
        "command": "deeplxSource.setToken",
        "title": "DeeplX: Set Access Token"
      },
      {
        "command": "deeplxSource.clearToken",
        "title": "DeeplX: Clear Access Token"
      }
    ],
    "configuration": {
      "title": "DeeplX Translation Source",
      "properties": {
        "deeplxSource.endpoint": {
          "type": "string",
          "scope": "application",
          "default": "http://127.0.0.1:1188/translate",
          "description": "Full URL of the DeeplX /translate endpoint."
        }
      }
    }
  }
}
