{
  "name": "deeplx-translate",
  "displayName": "DeeplX for Comment Translate",
  "description": "DeeplX translate source for comment-translate",
  "version": "0.1.4",
  "publisher": "Missdrop",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "icon": "images/icon.png",
  "extensionDependencies": [
    "intellsmi.comment-translate"
  ],
  "activationEvents": [
    "onCommand:deeplxSource.setEndpoint",
    "onCommand:deeplxSource.setToken",
    "onCommand:deeplxSource.clearToken"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "contributes": {
    "translates": [
      {
        "translate": "dlx",
        "title": "DeeplX"
      }
    ],
    "commands": [
      {
        "command": "deeplxSource.setEndpoint",
        "title": "DeeplX: Set Endpoint"
      },
      {
        "command": "deeplxSource.setToken",
        "title": "DeeplX: Set Access Token"
      },
      {
        "command": "deeplxSource.clearToken",
        "title": "DeeplX: Clear Access Token"
      }
    ],
    "configuration": {
      "title": "DeeplX for Comment Translate",
      "properties": {
        "deeplxSource.endpoint": {
          "type": "string",
          "scope": "application",
          "default": "http://127.0.0.1:1188/translate",
          "markdownDescription": "Full URL of the DeeplX /translate endpoint. If your server requires a separate Bearer token, [Set Access Token](command:deeplxSource.setToken)."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Missdrop/deeplx-translate.git"
  }
}
